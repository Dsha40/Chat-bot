# --- Servidor ---
PORT=3000
DATA_DIR=./data
CLINIC_CONFIG=./config/clinica.json
# Token para las rutas /admin (reanudar el bot, ver costos). Déjalo vacío para desactivarlas.
ADMIN_TOKEN=

# --- IA (Gemini). Clave gratis en https://aistudio.google.com/apikey ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo principal y modelo de respaldo si el principal falla.
# Ejecuta `npm run models` con tu clave para ver los IDs disponibles.
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto libre que inventas tú y pegas también en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# "App secret" de tu app de Meta, para verificar la firma de los webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Plantilla "utility" aprobada para recordatorios (opcional). Parámetros: {{1}} nombre, {{2}} fecha y hora, {{3}} clínica.
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es
# Números del personal, separados por comas (formato 58412XXXXXXX). Reciben los avisos de derivación
# y pueden controlar el bot escribiéndole: #pausa, #activa, #pausa NUMERO, #activa NUMERO, #estado.
STAFF_WHATSAPP=
# Horas que el bot se calla con un paciente cuando el personal le escribe o cuando deriva a una persona.
HANDOFF_HOURS=12
# Espera (ms) para juntar varios mensajes seguidos del paciente en una sola respuesta.
DEBOUNCE_MS=2500

# --- Google Calendar (opcional; sin esto se usa la agenda interna) ---
# Ruta al JSON de una cuenta de servicio con acceso al calendario de la clínica.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
